{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/schemas/plan_document.json",
  "title": "PlanDocument",
  "description": "The central pipeline document produced by the Planning Advisor and validated by the Readiness Gate. Consumed by Test Agent, Implementation Agent, and Code Reviewer.",
  "type": "object",
  "required": [
    "aegis_version",
    "document_type",
    "document_id",
    "project_id",
    "task_id",
    "timestamp",
    "stage",
    "status",
    "user_intent",
    "architecture",
    "tasks",
    "scope_boundaries",
    "risks",
    "context"
  ],
  "properties": {
    "aegis_version": {
      "type": "string",
      "description": "Aegis version that produced this document"
    },
    "document_type": {
      "type": "string",
      "const": "PlanDocument"
    },
    "document_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this document"
    },
    "parent_document_id": {
      "type": ["string", "null"],
      "description": "UUID of the parent document, or null for root documents"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stage": {
      "type": "string",
      "enum": ["plan", "build", "review"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "validated", "rejected", "approved"]
    },
    "user_intent": {
      "type": "string",
      "minLength": 1,
      "description": "One-paragraph summary of what the user wants"
    },
    "architecture": {
      "type": "object",
      "required": ["components", "decisions"],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "responsibility"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "responsibility": { "type": "string", "minLength": 1 },
              "interfaces": {
                "type": "object",
                "properties": {
                  "inputs": { "type": "array", "items": { "type": "string" } },
                  "outputs": { "type": "array", "items": { "type": "string" } }
                }
              },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["decision", "rationale"],
            "properties": {
              "decision": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "alternatives_considered": {
                "type": "array",
                "items": { "type": "string" }
              },
              "trade_offs": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "description", "acceptance_criteria"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["criterion_id", "description"],
              "properties": {
                "criterion_id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "test_approach": {
                  "type": "string",
                  "enum": ["unit", "integration", "property", "e2e"]
                }
              },
              "additionalProperties": true
            }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "target_files": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "scope_boundaries": {
      "type": "object",
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "likelihood", "mitigation"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "likelihood": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "mitigation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "existing_architecture_ref": { "type": ["string", "null"] },
        "relevant_previous_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "known_constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
