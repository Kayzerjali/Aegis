{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/schemas/review_report.json",
  "title": "ReviewReport",
  "description": "Produced by the Review stage. Contains the code review verdict, issues found, and knowledge entries for Project Memory.",
  "type": "object",
  "required": [
    "aegis_version",
    "document_type",
    "document_id",
    "project_id",
    "task_id",
    "timestamp",
    "stage",
    "status",
    "build_report_id",
    "verdict"
  ],
  "properties": {
    "aegis_version": { "type": "string" },
    "document_type": { "type": "string", "const": "ReviewReport" },
    "document_id": { "type": "string", "format": "uuid" },
    "parent_document_id": { "type": ["string", "null"] },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "stage": { "type": "string", "enum": ["plan", "build", "review"] },
    "status": { "type": "string", "enum": ["draft", "validated", "rejected", "approved"] },
    "build_report_id": {
      "type": "string",
      "description": "UUID of the BuildReport being reviewed"
    },
    "verdict": {
      "type": "string",
      "enum": ["approved", "changes_requested", "rejected"]
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "satisfied"],
        "properties": {
          "criterion": { "type": "string" },
          "satisfied": { "type": "boolean" },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "suggestion"] },
          "category": { "type": "string", "enum": ["correctness", "security", "performance", "style", "documentation"] },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "suggested_fix": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "documentation_updates": {
      "type": "object",
      "properties": {
        "architecture_changes": { "type": "boolean" },
        "new_components": { "type": "array", "items": { "type": "string" } },
        "modified_interfaces": { "type": "array", "items": { "type": "string" } },
        "new_dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "knowledge_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": { "type": "string", "enum": ["bug_encountered", "decision_made", "pattern_learned", "risk_identified"] },
          "description": { "type": "string" },
          "resolution": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
