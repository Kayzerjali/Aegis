{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/schemas/build_report.json",
  "title": "BuildReport",
  "description": "Produced by the Build stage. Reports success or failure of code generation and testing. Consumed by the Review stage.",
  "type": "object",
  "required": [
    "aegis_version",
    "document_type",
    "document_id",
    "project_id",
    "task_id",
    "timestamp",
    "stage",
    "status",
    "plan_document_id",
    "build_status"
  ],
  "properties": {
    "aegis_version": { "type": "string" },
    "document_type": { "type": "string", "const": "BuildReport" },
    "document_id": { "type": "string", "format": "uuid" },
    "parent_document_id": { "type": ["string", "null"] },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "stage": { "type": "string", "enum": ["plan", "build", "review"] },
    "status": { "type": "string", "enum": ["draft", "validated", "rejected", "approved"] },
    "plan_document_id": {
      "type": "string",
      "description": "UUID of the PlanDocument this build implements"
    },
    "build_status": {
      "type": "string",
      "enum": ["success", "failed", "escalated_to_human"],
      "description": "Outcome of the build cycle"
    },
    "tasks_completed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id"],
        "properties": {
          "task_id": { "type": "string" },
          "files_created": { "type": "array", "items": { "type": "string" } },
          "files_modified": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria_met": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "test_results": {
      "type": "object",
      "properties": {
        "total_tests": { "type": "integer", "minimum": 0 },
        "passing": { "type": "integer", "minimum": 0 },
        "failing": { "type": "integer", "minimum": 0 },
        "mutation_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "mutation_rounds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "build_metrics": {
      "type": "object",
      "properties": {
        "total_iterations": { "type": "integer", "minimum": 0 },
        "debug_attempts": { "type": "integer", "minimum": 0 },
        "fresh_agent_invoked": { "type": "boolean" },
        "total_duration_seconds": { "type": "integer", "minimum": 0 },
        "agents_used": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "code_diff": { "type": "string" },
    "failure_summary": { "type": "string" },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt_number": { "type": "integer" },
          "agent": { "type": "string" },
          "approach": { "type": "string" },
          "test_output": { "type": "string" },
          "outcome": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "agent_hypothesis": { "type": "string" },
    "suggested_human_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_results_at_failure": {
      "type": "object",
      "properties": {
        "total_tests": { "type": "integer" },
        "passing": { "type": "integer" },
        "failing": { "type": "integer" },
        "failing_test_names": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
